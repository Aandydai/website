# Unsplash API Access Key (for homepage random backgrounds)
UNSPLASH_ACCESS_KEY=

# Required: Set by Vercel Postgres integration automatically
# POSTGRES_URL=

# Required: Your deployed site URL (e.g. https://your-site.vercel.app)
SITE_URL=http://localhost:3000

# Optional: If not set, a random secret will be generated on each cold start
# (This means all admin sessions will be invalidated on each deploy)
JWT_SECRET=

# Required for file uploads: Get from Vercel Blob dashboard
# BLOB_READ_WRITE_TOKEN=

# Optional: Initial admin password (defaults to PROMISE110820qq)
# ADMIN_INITIAL_PASSWORD=
